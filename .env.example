# Copy to .env.local. Do not commit real secrets.
#
# ADMIN_USERNAMES — comma-separated handles that are admin when they sign in.
# That is the normal way to get an admin. Grant or revoke others at /admin/users.
#
# ADMIN_PASSWORD / ADMIN_SECRET are an optional fallback for /admin/login.
# Example values (metered, change-me, generate-a-long-random-string,
# dev-only-not-for-production) are rejected. Production also rejects short
# values (password < 12, secret < 24).
#
# Never put model provider API keys here. The web app does not accept them.
# Run evals locally with the CLI; keys stay on that machine.
#
# Local Postgres. Production DATABASE_URL is written by `buidl add postgres`
# into .buidl/secrets (in-cluster host metered-postgres).
#
#   docker run --name metered-pg -e POSTGRES_PASSWORD=metered-dev \
#     -e POSTGRES_DB=metered -p 5432:5432 -d postgres:17

ADMIN_USERNAMES=danecwalker
ADMIN_PASSWORD=change-me
ADMIN_SECRET=generate-a-long-random-string
DATABASE_URL=postgres://postgres:metered-dev@localhost:5432/metered
NEXT_PUBLIC_GITHUB_REPO=
# Same 32-byte base64 key on every instance. Without it, /eval uploads 404
# after a deploy (UnrecognizedActionError). Production is in .buidl/secrets.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
