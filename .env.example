# Copy to .env.local and replace both admin values. Do not commit real secrets.
#
# Login is disabled when ADMIN_PASSWORD or ADMIN_SECRET is missing or still an
# example: metered, change-me, generate-a-long-random-string,
# dev-only-not-for-production.
#
# NODE_ENV=production also rejects short values (password < 12, secret < 24).
#
# Never put model provider API keys here. The web app does not accept them.
# Run evals locally with the CLI; keys stay on that machine.
#
# DATABASE_URL is local SQLite by default. That is fine on a Node host with a
# disk. Serverless filesystems are ephemeral — use a persistent libSQL URL if
# the index should survive deploys.
#
# Optional fork. Blank uses danecwalker/metered on /eval.

ADMIN_PASSWORD=change-me
ADMIN_SECRET=generate-a-long-random-string
DATABASE_URL=file:./data/metered.db
NEXT_PUBLIC_GITHUB_REPO=
